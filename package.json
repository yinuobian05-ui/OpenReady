{
  "name": "@yb5/openready",
  "version": "0.1.2",
  "description": "Offline pre-publication hygiene checks for Git repositories.",
  "author": "Yinuo Bian",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yinuobian05-ui/OpenReady.git"
  },
  "homepage": "https://github.com/yinuobian05-ui/OpenReady#readme",
  "bugs": {
    "url": "https://github.com/yinuobian05-ui/OpenReady/issues"
  },
  "type": "module",
  "bin": {
    "openready": "bin/openready.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/boundaries.test.js test/cli.test.js test/rules.test.js",
    "scan": "node ./bin/openready.js scan ."
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "beta-testing.md",
    "docs/pre-beta-evaluation.md",
    "docs/releases/v0.1.2.md"
  ],
  "keywords": [
    "git",
    "privacy",
    "security",
    "open-source",
    "cli"
  ],
  "license": "MIT"
}
